# syntax=docker/dockerfile:1

# Базовий образ з Python 3.11 (multi-arch, нормально працює на Mac з Docker Desktop)
FROM python:3.11-slim AS base

# Робоча директорія всередині контейнера
WORKDIR /app

# Встановлюємо мінімальний набір системних залежностей
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
 && rm -rf /var/lib/apt/lists/*

# Спочатку копіюємо тільки requirements.txt, щоб кешувати встановлення залежностей
COPY requirements.txt .

# Встановлюємо Python-залежності
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# Тепер копіюємо весь код у контейнер
COPY . .

# Значення за замовчуванням для змінних оточення
# (їх можна перевизначити через docker run / docker compose)
ENV APP_ENV=prod \
    APP_PORT=8000 \
    INFERENCE_DEVICE=cpu \
    MODEL_CLASS_PATH=models.traffic_gnn.TrafficGraphNeuralNetwork \
    MODEL_ARTIFACT_URI=./models/traffic_gnn_toy.pt \
    MODEL_INPUT_FEATURES=1 \
    MODEL_HIDDEN_UNITS=16 \
    MODEL_OUTPUT_FEATURES=1 \
    PYTHONUNBUFFERED=1

# Відкриваємо порт 8000 всередині контейнера
EXPOSE 8000

# Якщо хочеш використовувати entrypoint.sh — можна так:
# ENTRYPOINT ["bash", "entrypoint.sh"]

# А поки що стартуємо напряму uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]